      "namespace": "ai.eval",
      "displayName": "Foundry evaluations (Beta)",
      "description": "Define and run Foundry evaluations from your terminal. (Beta)",
      "versions": [
        {
          "version": "1.0.38-beta",
          "requiredAzdVersion": ">=1.33.0",
          "capabilities": [
            "custom-commands",
            "service-target-provider",
            "metadata"
          ],
          "providers": [
            {
              "name": "azure.ai.eval",
              "type": "service-target",
              "description": "Deploys evaluation datasets, evaluators, and eval groups to Foundry"
            }
          ],
          "usage": "azd ai eval <command> [options]",
          "examples": [
            {
              "name": "init",
              "description": "Scaffold evaluation config for an agent or completed conversations.",
              "usage": "azd ai eval init"
            },
            {
              "name": "run",
              "description": "Start, list, and read the results of evaluation runs.",
              "usage": "azd ai eval run <command>"
